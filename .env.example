# AI Provider Configuration
# Options: 'gemini' (default) or 'openai'
AI_PROVIDER=gemini

# Google Gemini API Key - Required if using Gemini (default)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (optional, defaults to gemini-3-flash-preview)
# GEMINI_MODEL=gemini-3-flash-preview

# Gemini Thinking Level (optional, defaults to 'low')
# Options: 'minimal', 'low', 'medium', 'high'
# GEMINI_THINKING_LEVEL=low

# OpenAI API Key - Required if using OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model (optional, defaults to gpt-5.2)
# OPENAI_MODEL=gpt-5.2

# Server Port (optional, defaults to 3000)
PORT=3000
